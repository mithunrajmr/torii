# ============================================================
# TORII — Autonomous Branch Operations & Compliance Engine
# Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────
# Secret used to sign kiosk JWTs. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-secret

# ── Frontend domain (used in QR deep-link URL) ───────────
DOMAIN=localhost:5173

# ── PostgreSQL (Supabase) ─────────────────────────────────
# Get from: Supabase project > Settings > Database > Connection string
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Redis (Upstash) ───────────────────────────────────────
# Get from: Upstash console > your database > REST API
REDIS_URL=https://[your-db].upstash.io
REDIS_TOKEN=your-upstash-rest-token

# ── Email / OTP Notification Gateway ─────────────────────
# Point this at a service that accepts POST /send with { to, otp }.
# Leave blank in dev — OTP will be logged to console only.
NOTIFICATION_GATEWAY_URL=

# ── IBM watsonx Orchestrate ───────────────────────────────
# IBM Cloud IAM API key — get from:
#   IBM Cloud > Manage > Access (IAM) > API keys > Create
WATSONX_ORCHESTRATE_API_KEY=your-ibm-cloud-iam-api-key

# Your watsonx Orchestrate instance API endpoint.
# Found in: IBM Cloud > Resource list > watsonx Orchestrate > Credentials
WATSONX_ORCHESTRATE_ENDPOINT=https://api.us-south.watson-orchestrate.cloud.ibm.com

# Agent IDs — get these by running: orchestrate agents list
# after running watsonx-orchestrate/import-all.sh
WXO_VISION_AGENT_ID=torii-vision-ocr-agent
WXO_WATCHDOG_AGENT_ID=torii-watchdog-aml-agent
WXO_ADVISOR_AGENT_ID=torii-advisor-agent
