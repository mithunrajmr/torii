# ============================================================
# TORII — Autonomous Branch Operations & Compliance Engine
# Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================
# When the backend starts it will print a warning for every
# variable that is missing, showing which service will break.
# ============================================================

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────
# Secret used to sign kiosk JWTs (CUSTOMER role).
# Use a long random string in production — e.g. openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# ── Frontend domain (used in QR deep-link URL) ───────────
# In dev: localhost:5173 (Vite default port)
# In production: your Vercel domain, e.g. torii.vercel.app
DOMAIN=localhost:5173

# ── PostgreSQL (Supabase) ─────────────────────────────────
# Get from: Supabase project > Settings > Database > Connection string
# Run migrations 001, 002, 003 in the Supabase SQL editor before first use.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Storage bucket must be created manually:
#   Supabase > Storage > New bucket > Name: pan-documents > Private: ON

# ── Redis (Upstash) ───────────────────────────────────────
# Get from: Upstash console > your database > REST API tab
REDIS_URL=https://[your-db].upstash.io
REDIS_TOKEN=your-upstash-rest-token

# ── Email / OTP Delivery ──────────────────────────────────
# Priority: SMTP (Option A) → Resend (Option B) → Gateway (Option C) → console log
#
# Option A — Brevo SMTP (recommended, works with any SMTP provider):
#   1. Log in to Brevo → SMTP & API → SMTP tab
#   2. Copy your SMTP key (different from your account password)
#   Brevo free tier: 300 emails/day, no domain verification needed.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@example.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=TORII Bank <noreply@yourdomain.com>

# Option B — Resend REST API (alternative to SMTP):
#   Only used if SMTP_HOST is not set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=TORII Bank <noreply@yourdomain.com>

# Option C — Custom HTTP gateway:
#   Point at any service that accepts POST { to, subject, body }.
#   Only used if SMTP_HOST and RESEND_API_KEY are both not set.
NOTIFICATION_GATEWAY_URL=

# If none of the above are set: OTP is printed to the server console (dev only).

# ── IBM watsonx Orchestrate ───────────────────────────────
# Step 1: Get IBM Cloud account at https://cloud.ibm.com
# Step 2: Create a watsonx Orchestrate instance
# Step 3: Create an IAM API key:
#   IBM Cloud > Manage > Access (IAM) > API keys > Create
WATSONX_ORCHESTRATE_API_KEY=your-ibm-cloud-iam-api-key

# Step 4: Find your instance endpoint:
#   IBM Cloud > Resource list > watsonx Orchestrate > Credentials
WATSONX_ORCHESTRATE_ENDPOINT=https://api.us-south.watson-orchestrate.cloud.ibm.com

# Step 5: Import ALL agents + tools (run from watsonx-orchestrate/ directory).
#   Easiest: run the import script which handles correct dependency order:
#   cd watsonx-orchestrate && bash import-all.sh
#
#   Or import manually in this exact order (tools first, then leaf agents, then orchestrator):
#
#   — Tools —
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe env add -n torii-prod -u <endpoint> --type ibm_iam
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe env activate torii-prod --api-key <key>
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe tools import -k python -f watsonx-orchestrate/tools/extract_pan_tool.py
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe tools import -k python -f watsonx-orchestrate/tools/aml_watchdog_tool.py
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe tools import -k python -f watsonx-orchestrate/tools/advisor_tool.py
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe tools import -k python -f watsonx-orchestrate/tools/bank_faq_tool.py        ← Session 3: 40-entry KB + log_faq_query
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe tools import -k python -f watsonx-orchestrate/tools/localizer_tool.py
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe tools import -k python -f watsonx-orchestrate/tools/translate_response_tool.py
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe tools import -k python -f watsonx-orchestrate/tools/orchestrator_tool.py
#
#   — Leaf agents (no collaborators) —
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe agents import -f watsonx-orchestrate/agents/vision-ocr-agent/agent.yaml
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe agents import -f watsonx-orchestrate/agents/watchdog-aml-agent/agent.yaml
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe agents import -f watsonx-orchestrate/agents/advisor-agent/agent.yaml
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe agents import -f watsonx-orchestrate/agents/faq-agent/agent.yaml             ← Session 3: updated KB + log_faq_query
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe agents import -f watsonx-orchestrate/agents/localizer-agent/agent.yaml
#
#   — Orchestrator last (depends on faq + localizer collaborators) —
#   uvx --from "ibm-watsonx-orchestrate==2.1.0" orchestrate.exe agents import -f watsonx-orchestrate/agents/orchestrator-agent/agent.yaml
#
# Step 6: Get agent IDs — run: orchestrate agents list
#   Copy each agent's ID into the WXO_* vars below.

# Swarm agents (document processing + HITL pipeline)
WXO_VISION_AGENT_ID=your-vision-agent-uuid
WXO_WATCHDOG_AGENT_ID=your-watchdog-agent-uuid
WXO_ADVISOR_AGENT_ID=your-advisor-agent-uuid

# Pipeline agents (kiosk query routing + FAQ + multilingual)
WXO_FAQ_AGENT_ID=your-faq-agent-uuid
WXO_LOCALIZER_AGENT_ID=your-localizer-agent-uuid
WXO_ORCHESTRATOR_AGENT_ID=your-orchestrator-agent-uuid
