{
  "name": "torii-autonomous-branch-compliance",
  "version": "1.0.0",
  "description": "Autonomous Branch Operations & Compliance Engine",
  "main": "backend/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend:dev": "node backend/src/index.js",
    "dev:all": "concurrently -n \"frontend,backend\" -c \"cyan,green\" \"npm run dev\" \"npm run backend:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node backend/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/api tests/cache",
    "test:e2e": "vitest run tests/e2e",
    "migrate": "node backend/src/db/migrate.js"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/redis": "^1.34.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.427.0",
    "multer": "^2.2.0",
    "nodemailer": "9.0.3",
    "postgres": "^3.4.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^2.5.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "fast-check": "^3.20.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.41",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
